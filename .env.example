# Where sign-ups are delivered. Create a free URL at https://webhook.site and paste it here.
# Anyone with this URL can read what is posted to it, so the sign-up form collects no secrets.
SIGNUP_WEBHOOK_URL=https://webhook.site/00000000-0000-0000-0000-000000000000

# Optional: serve a built frontend from the API (the Docker image sets this).
# STATIC_DIR=../frontend/dist
